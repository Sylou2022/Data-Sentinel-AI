# ---- Claude (rédaction des explications métier) -------------------------------
# Collez votre clé API Anthropic (console.anthropic.com → API Keys, commence par sk-ant-api…).
# Ce fichier est ignoré par git : ne le partagez pas.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATASENTINEL_LLM_PROVIDER=none
DATASENTINEL_LLM_MODEL=claude-opus-5-5

# ---- SQL Server (lecture seule) -------------------------------------------------
SQLSERVER_SERVER=localhost\SQLEXPRESS
SQLSERVER_DATABASE=Data_Sentinel_AI
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TRUSTED_CONNECTION=yes
# Pour un compte SQL dédié (recommandé : membre de db_datareader uniquement) :
# SQLSERVER_TRUSTED_CONNECTION=no
# SQLSERVER_USER=datasentinel_reader
# SQLSERVER_PASSWORD=
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
# Mapping personnalisé (autre schéma) : fichier JSON {"orders": "SELECT ...", ...}
# SQLSERVER_MAPPING_FILE=config/mapping.json
